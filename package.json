  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@mariozechner/pi-ai": "0.56.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "p-queue": "^9.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
