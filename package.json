{
  "name": "reviewflux",
  "version": "0.1.0",
  "description": "CLI-first event-driven review runtime",
  "bin": {
    "rvw": "dist/cli/index.mjs",
    "reviewflux": "dist/cli/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit -p tsconfig.json",
    "changeset": "changeset",
    "dev": "node scripts/run-node.mjs",
    "depcruise": "depcruise --validate .dependency-cruiser.cjs src",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test:all",
    "prepare": "husky",
    "release": "changeset publish",
    "rvw": "node scripts/run-node.mjs",
    "reviewflux": "node scripts/run-node.mjs",
    "test": "vitest run",
    "test:all": "pnpm build && pnpm check && pnpm lint && pnpm depcruise && pnpm test",
    "validate:pre-commit": "pnpm check && pnpm lint && pnpm depcruise",
    "validate:pre-push": "pnpm check",
    "version-packages": "changeset version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ssoon-m/reviewflux.git"
  },
  "keywords": [
    "ai",
    "cli",
    "code-review"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src/commands/setup/REVIEWFLUX-AGENTS.md"
  ],
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "bugs": {
    "url": "https://github.com/Ssoon-m/reviewflux/issues"
  },
  "homepage": "https://github.com/Ssoon-m/reviewflux#readme",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@mariozechner/pi-ai": "0.56.2",
    "better-sqlite3": "^12.6.2",
    "commander": "13.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "dependency-cruiser": "^17.3.9",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.3"
}
